              fill="none" stroke="currentColor" stroke-width="2" opacity="0.6"
            />
            <!-- The 9 California national parks, positioned by real latitude/longitude
                 against the state outline above (not a stylized approximation). -->
            <g stroke="currentColor" stroke-width="1" opacity="0.5" fill="none">
              <path d="M 20,25 L 95,53 L 140,147 L 168,184 L 160,192 L 195,215 L 210,286 L 95,282 L 70,195 Z" stroke-dasharray="3 5" />
            </g>
