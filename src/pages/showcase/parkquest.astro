    display: grid;
    place-items: center;
    position: relative;
  }
  .pq-seal::before {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--pq-gold) 40%, transparent);
  }
  .pq-seal span {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--pq-gold);
  }
  .pq-badgedots {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .pq-badgedots i {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    display: block;
  }

  .pq-frow {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .pq-avs {
    display: flex;
    flex: none;
    /* Scope the negative z-index below to this stack's own stacking
       context — otherwise it escapes to the card's background instead of
       just tucking behind the neighboring avatar. */
    isolation: isolate;
  }
  .pq-avs i {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 2px solid #16281c;
    margin-left: -0.6rem;
    display: grid;
    place-items: center;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6rem;
    font-style: normal;
    color: #12210f;
  }
  .pq-avs i:first-child {
    margin-left: 0;
  }
  .pq-avs-more {
    background: color-mix(in oklab, var(--text-tertiary) 20%, transparent);
    color: var(--text-tertiary) !important;
    z-index: -1;
  }
  .pq-frow-note {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--text-tertiary);
    line-height: 1.4;
    margin: 0;
  }

  /* Pinned feature scroller */
  .pq-features {
    max-width: none;
    padding: 0;
  }
  .pq-feature-grid {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (max-width: 640px) {
    .pq-feature-grid {
      padding: 3rem 1.25rem;
      gap: 2.5rem;
    }
  }
  @media (min-width: 900px) {
    .pq-feature-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
    }
  }

  .pq-phone-stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .pq-phone-stage {
      align-self: start;
    }
  }

  .pq-phone {
    position: relative;
    /* min() instead of a flat 300px — on narrow viewports (~360px and
       below), 300px plus the section's 2rem side padding no longer fits
       and pushed the page into horizontal scroll. */
    width: min(300px, 100%);
    /* Kept at the trace SVG's native ratio on purpose — stretching this
       non-uniformly (with preserveAspectRatio="none") turns the bezel's
       circular corners into ellipses that a plain CSS border-radius can't
       match, leaving a visible gap at the top corners. Not worth it. */
    aspect-ratio: 1350 / 2760;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
  }
  /* Below 900px the phone and captions stack and pin as one block (see the
     script) instead of sitting pinned side by side — so the phone also has
     to leave room for the caption underneath it within a single screen's
     height. Capping width by vh (not just px/vw) scales the phone — and so
     its height, via the fixed aspect-ratio — down on shorter viewports and
     up on taller ones, instead of one fixed size that fits some phones and
     not others. */
  @media (max-width: 899px) {
    .pq-phone {
      width: min(300px, 100%, 24vh);
    }
  }
  /* Nudge that this is a pinned, scroll-scrubbed section, not a stuck page —
     shows up if the user pauses mid-sequence (JS toggles .is-visible) and
     hides the instant they scroll again or finish the sequence. */
  .pq-keep-scrolling {
    position: absolute;
    left: 50%;
    /* top is set from JS — tracks the bottom edge of whichever caption's
       text is currently active, since captions vary a lot in length and
       are vertically centered in their box (so their own bottom edge
       moves too), rather than sitting at one fixed spot below the stage. */
    top: 0;
    /* Y offset lives in the JS-computed `top` value below, not here — the
       .is-visible pulse keyframes (pq-scroll-cue-pulse) set their own
       `transform: translate(-50%, 0/10px)`, which fully overrides
       whatever Y translate this rule declares the instant the animation
       is running (the only time this element is ever actually visible).
       A Y component here was silently dead code. */
    transform: translateX(-50%);
    width: 26px;
    height: 26px;
    /* Bigger invisible hit area than the visible glyph — a 26px chevron
       is a small target to click precisely. */
    padding: 10px;
    margin: -10px;
    box-sizing: content-box;
    color: var(--pq-gold-soft);
    opacity: 0;
    transition: opacity 0.4s ease, top 0.3s ease, color 0.2s ease;
    pointer-events: none;
  }
  .pq-keep-scrolling.is-visible {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
    animation: pq-scroll-cue-pulse 1.8s ease-in-out infinite;
  }
  .pq-keep-scrolling.is-visible:hover {
    color: var(--pq-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-keep-scrolling.is-visible { animation: none; }
  }
  /* Shows once the active screen's video plays through to the end (Apple-
     style "replay" link), hides again the moment the screen changes. */
  .pq-replay {
    position: absolute;
    left: 50%;
    bottom: -1.6rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--pq-gold-soft);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, color 0.2s ease;
  }
  .pq-replay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .pq-replay:hover {
    color: var(--pq-gold);
  }
  .pq-replay-icon {
    width: 15px;
    height: 15px;
  }
  /* Bounding box of the real screen cutout in iphone-trace.svg; the outline
     overlay below draws the precise curved edge on top of this rectangle. */
  .pq-phone-screen-hole {
    position: absolute;
    /* The outline SVG's own silhouette doesn't reach the very edges of its
       viewBox on either end — pixel-scanning the rendered trace found a
       ~1% margin at the top and ~1.2% at the bottom before the frame art
       actually starts/stops. Content can't cross either or it shows
       through the transparent margin, past the frame entirely, against
       the page background — not miscropped, genuinely outside the phone. */
    top: 2.2%;
    /* Widened past the 4.1% that exactly matches content aspect at the
       original top+bottom budget (2.6%) — more margin on both edges needs
       more combined budget (now 4%), and the only way to keep the same
       0.461 content aspect at a bigger budget is a narrower box. */
    left: 4.8%;
    right: 4.8%;
    bottom: 1.8%;
    /* Rounded well past what the frame's own curve strictly needs, on
       purpose — the bezel is a hand trace, not a perfect arc, and erring
       toward "tucked further behind the frame" is a much safer failure
       mode than content poking past the visible corner. */
    border-radius: 3rem;
    overflow: hidden;
    background: #050505;
  }
  .pq-phone-outline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .pq-phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .pq-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--pq-gold);
  }
  .pq-screen-2, .pq-screen-3, .pq-screen-4, .pq-screen-5, .pq-screen-6 {
    /* hidden by default; JS controls visibility as the pinned scroll advances */
    opacity: 0;
    visibility: hidden;
  }
  .pq-screen-label {
    position: absolute;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0.6;
  }
  .pq-screen-svg {
    width: 85%;
    height: auto;
  }
  .pq-screen-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #050505;
  }

  /* Captions overlap and crossfade in place (like the phone's own screens)
     instead of stacking in normal flow — that's what lets the active one
     stay centered regardless of how much text it holds. At 900px+ this
     sits beside the phone and is pinned separately (JS sets this box's
     height to match .pq-phone's real height so both land at the same
     pinned top offset and land centered together); below 900px it stacks
     under the phone and rides along in the same single pinned block
     instead (see the script). */
  .pq-captions-stage {
    position: relative;
    width: 100%;
  }
  @media (min-width: 900px) {
    .pq-captions-stage {
      align-self: start;
    }
  }
  .pq-captions {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 20rem;
    /* Captions now slide in/out on the Y axis (reel/detent effect) instead
       of crossfading in place — clip so the outgoing/incoming caption's
       travel through the box never spills past its edges. */
    overflow: hidden;
  }
  /* Shorter fixed floor below 900px — this box isn't matched to the
     phone's height here (see the script), and the full 20rem desktop
     value would blow out the combined pinned block's height on its own. */
  @media (max-width: 899px) {
    .pq-captions {
      min-height: 13rem;
    }
  }
  .pq-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
  }
  .pq-caption:not(.pq-caption-1) {
    opacity: 0;
    visibility: hidden;
  }
  .pq-caption h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .pq-caption-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: var(--pq-gold);
  }
  .pq-caption p {
    color: var(--text-tertiary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 26rem;
  }

  /* Slide-position dots — hugs the true right edge of the viewport via
     plain position:fixed (not tied to the grid's own max-width/centering,
     which leaves a big variable gap on wide screens and almost none on
     medium ones), shown only while the pinned scroller is actually active
     (JS toggles .is-visible off tl's own ScrollTrigger.isActive). */
  .pq-slide-dots {
    position: fixed;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 20;
  }
  .pq-slide-dots.is-visible {
    opacity: 1;
  }
  /* Below 900px the captions column runs nearly full viewport width with
     centered text close to its own edges, and there's no side-by-side gap
     to sit in — the dots only show once that layout is in play. */
  @media (max-width: 899px) {
    .pq-slide-dots {
      display: none;
    }
  }
  .pq-slide-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-tertiary);
    opacity: 0.35;
    transition: opacity 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }
  .pq-slide-dot.is-active {
    background: var(--pq-gold);
    opacity: 1;
    transform: scale(1.4);
  }

  /* Phone carousel */
  .pq-carousel-section {
    padding: 2rem 0 6rem;
    overflow: hidden;
  }
  .pq-phone-carousel {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .pq-phone-carousel-track {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    width: max-content;
    /* Duration scaled with the track's width (currently 34 unique slides)
       to keep the drift speed in px/s roughly constant. */
    animation: pq-carousel-drift 160s linear infinite;
  }
  @keyframes pq-carousel-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-phone-carousel-track { animation: none; }
  }

  .pq-mini-phone {
    position: relative;
    flex: none;
    width: 170px;
    aspect-ratio: 1350 / 2760;
    /* Tighter and softer than before — at a bigger blur/opacity this read
       as a rectangular dark-blue smudge behind each phone rather than a
       shadow hugging the rounded shape. */
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.3));
  }
  .pq-mini-phone-screen {
    position: absolute;
    top: 1.7%;
    left: 4.8%;
    right: 4.8%;
    bottom: 1.8%;
    /* Rounded a bit past what the bezel's own corner curve strictly needs
       (same margin-of-safety approach as the main phone mockup) — a
       screenshot's square corner peeking past the bezel's rounded mask
       used to show as a mismatched dark square. Background matched to
       the page itself so even a stray sliver blends in instead of
       contrasting as a different shade of "dark". */
    border-radius: 2.1rem;
    overflow: hidden;
    background: var(--bg-primary);
  }
  .pq-mini-phone-screen img,
  .pq-mini-phone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pq-mini-phone-outline {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* By the numbers */
  .pq-stats {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .pq-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    text-align: center;
  }
  @media (min-width: 700px) {
    .pq-stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pq-stat-num {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--pq-gold);
    margin-bottom: 0.5rem;
  }
  .pq-stat-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.4;
  }

  /* Built with — left column (stack + diagram) vs. right column (shared
     types reference) so the disjoint types card reads as sitting beside
     everything else, not just some leftover bolted onto the diagram. */
  .pq-bts-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .pq-bts-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }
  @media (min-width: 1300px) {
    .pq-bts-row {
      flex-direction: row;
      align-items: flex-start;
    }
    .pq-bts-left {
      flex: 1 1 auto;
    }
    .pq-types-card {
      flex: 0 0 260px;
    }
  }
  .pq-diagram {
    position: relative;
    color: var(--pq-gold);
    overflow-x: auto;
  }
  .pq-types-card {
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.9rem;
    background: var(--bg-card);
  }
  .pq-types-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.9rem;
  }
  .pq-types-row {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border-primary);
  }
  .pq-types-row:first-of-type {
    border-top: none;
  }
  .pq-types-label {
    display: block;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pq-gold-soft);
    margin-bottom: 0.3rem;
  }
  .pq-types-list {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }
  .pq-types-list code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }
  /* Hover a box (or its label) to spotlight its own path through the
     diagram — everything else dims instead. Quiet on purpose: no ambient
     motion, nothing until you actually interact with it. */
  .pq-diagram-svg [data-group] {
    transition: opacity 0.25s ease;
  }
  .pq-diagram-svg.pq-diagram-hovering [data-group] {
    opacity: 0.2;
  }
  .pq-diagram-svg.pq-diagram-hovering [data-group].is-active {
    opacity: 1;
  }
  .pq-diagram-hits rect {
    cursor: pointer;
    pointer-events: all;
  }
  @media (max-width: 700px) {
    .pq-diagram::after {
      content: "";
      position: absolute;
      inset: 0 0 0 auto;
      width: 2.5rem;
      background: linear-gradient(to right, transparent, var(--bg-primary));
      pointer-events: none;
    }
  }
  .pq-diagram-svg {
    width: 100%;
    min-width: 760px;
  }

  .pq-routes-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }
  .pq-routes-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  /* Route/tool card grid — used for both "Inside the API" and the admin
     tools list. Each category gets an icon chip so the grid reads at a
     glance instead of as a wall of label/description rows. */
  .pq-route-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 640px) {
    .pq-route-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .pq-route-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .pq-route-grid-admin {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* 7 cards over 2 or 3 columns always leaves one orphaned on its own row
     — center and cap its width instead of letting it stretch full-bleed
     or sit flush left. */
  @media (min-width: 640px) {
    .pq-route-grid:not(.pq-route-grid-admin) > :last-child {
      grid-column: 1 / -1;
      max-width: 360px;
      width: 100%;
      margin: 0 auto;
    }
  }
  .pq-route-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    background: var(--bg-card);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .pq-route-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--pq-gold) 45%, var(--border-primary));
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-route-card {
      transition: none;
    }
    .pq-route-card:hover {
      transform: none;
    }
  }
  .pq-route-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    background: color-mix(in oklab, var(--pq-gold) 12%, transparent);
    color: var(--pq-gold);
  }
  .pq-route-body {
    min-width: 0;
  }
  .pq-route-label {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--pq-gold);
    margin-bottom: 0.3rem;
  }
  .pq-route-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  .pq-route-desc code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }

  /* "Inside the API" as a tabbed code-editor mockup instead of a static
     grid — click a category, the panel below swaps to its real-shaped
     endpoints. More fun to poke at than a wall of cards, and the endpoint
     paths are concrete detail a static list didn't have room for. */
  .pq-api-explorer {
    margin-bottom: 2.5rem;
  }
  .pq-api-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  .pq-api-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-primary);
    background: var(--bg-card);
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .pq-api-tab:hover {
    border-color: color-mix(in oklab, var(--pq-gold) 45%, var(--border-primary));
    color: var(--text-primary);
    transform: translateY(-1px);
  }
  .pq-api-tab:focus-visible {
    outline: 2px solid var(--pq-gold);
    outline-offset: 2px;
  }
  .pq-api-tab[aria-selected="true"] {
    background: var(--pq-gold);
    border-color: var(--pq-gold);
    color: #1a1408;
  }
  .pq-api-tab[aria-selected="true"] .pq-api-tab-icon {
    color: #1a1408;
  }
  .pq-api-tab-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--pq-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-api-tab {
      transition: none;
    }
    .pq-api-tab:hover {
      transform: none;
    }
  }

  .pq-api-panel {
    border: 1px solid var(--border-primary);
    border-radius: 0.9rem;
    background: var(--bg-card);
    overflow: hidden;
  }
  .pq-api-panel-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
