---
// "Flagship" product page for ParkQuest — an Apple-style scroll experience:
// full-bleed hero, pinned scroll-scrubbed feature demo (real App Store
// screenshots), and a blueprint-style architecture teardown.
//
// Color: this page defines its own green/gold palette (--pq-*) scoped to
// .pq-page, matching the parkquest.me brand, instead of the site's global
// blue --accent-primary — kept local so the rest of the portfolio is
// untouched.
import { Image } from "astro:assets";
import Showcase from "../../layouts/Showcase.astro";
import parkquestLogo from "../../content/projects/parkquest-logo.png";
---

<Showcase
  title="ParkQuest"
  description="ParkQuest — a national park tracker for the U.S.'s 63 national parks, live on the App Store."
>
  <div class="pq-page">
    <!-- Hero -->
    <section class="pq-hero">
      <div class="pq-hero-glow" aria-hidden="true"></div>
      <div class="pq-hero-fade" aria-hidden="true"></div>
      <svg class="pq-hero-bg" viewBox="0 0 1600 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="pq-shoot-grad-1" gradientUnits="userSpaceOnUse" x1="260" y1="60" x2="200" y2="110">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
            <stop offset="100%" stop-color="currentColor" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="pq-shoot-grad-2" gradientUnits="userSpaceOnUse" x1="800" y1="40" x2="730" y2="70">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
            <stop offset="100%" stop-color="currentColor" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="pq-shoot-grad-3" gradientUnits="userSpaceOnUse" x1="1200" y1="150" x2="1145" y2="215">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
            <stop offset="100%" stop-color="currentColor" stop-opacity="0.9" />
          </linearGradient>
          <g id="pq-wind-lines" fill="none" stroke="#cfe0d1" stroke-width="1" opacity="0.12">
            <path d="M -100 260 C 200 220, 350 300, 600 250 S 1000 200, 1300 250 S 1600 220, 1750 260" />
            <path d="M -100 320 C 200 280, 350 360, 600 310 S 1000 260, 1300 310 S 1600 280, 1750 320" />
          </g>
        </defs>
        <g class="pq-wind-track">
          <use href="#pq-wind-lines" x="0" />
          <use href="#pq-wind-lines" x="1850" />
        </g>
        <g fill="currentColor" class="pq-hero-stars">
          <circle class="pq-star pq-star-1" cx="180" cy="150" r="1.6" />
          <circle class="pq-star pq-star-2" cx="420" cy="90" r="1.6" />
          <circle class="pq-star pq-star-3" cx="640" cy="180" r="1.4" />
          <circle class="pq-star pq-star-4" cx="900" cy="70" r="1.8" />
          <circle class="pq-star pq-star-5" cx="1180" cy="130" r="1.4" />
          <circle class="pq-star pq-star-6" cx="1390" cy="170" r="1.6" />
          <circle class="pq-star pq-star-7" cx="1040" cy="220" r="1.4" />
          <circle class="pq-star pq-star-8" cx="270" cy="260" r="1.4" />
          <circle class="pq-star pq-star-9" cx="530" cy="230" r="1.3" />
          <circle class="pq-star pq-star-10" cx="790" cy="150" r="1.5" />
          <circle class="pq-star pq-star-11" cx="1280" cy="240" r="1.3" />
          <circle class="pq-star pq-star-12" cx="1500" cy="100" r="1.6" />
        </g>
        <g class="pq-shooting-stars">
          <line class="pq-shoot pq-shoot-1" x1="260" y1="60" x2="200" y2="110" stroke="url(#pq-shoot-grad-1)" stroke-width="1.6" stroke-linecap="round" />
          <line class="pq-shoot pq-shoot-2" x1="800" y1="40" x2="730" y2="70" stroke="url(#pq-shoot-grad-2)" stroke-width="1.4" stroke-linecap="round" />
          <line class="pq-shoot pq-shoot-3" x1="1200" y1="150" x2="1145" y2="215" stroke="url(#pq-shoot-grad-3)" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <!-- back ridge -->
        <polygon points="-100,520 150,260 420,480 700,180 1000,470 1300,300 1750,520 1750,800 -100,800" fill="#1c3524" opacity="0.85" />
        <!-- mid ridge -->
        <polygon points="-100,600 250,380 550,600 850,320 1150,610 1450,400 1750,600 1750,800 -100,800" fill="#152a1c" opacity="0.92" />
        <!-- front ridge -->
        <polygon points="-100,700 300,520 650,700 1000,460 1350,700 1750,540 1750,800 -100,800" fill="#0f2015" />
      </svg>

      <div class="pq-hero-content page-fade-in">
        <Image src={parkquestLogo} alt="ParkQuest app icon" class="pq-app-icon" width={200} height={200} />

        <!-- <p class="pq-eyebrow">EST. 2026 &middot; 63 PARKS &middot; ONE QUEST</p> -->
        <h1 class="pq-title">ParkQuest</h1>
        <p class="pq-tagline">Every park. One journal.</p>
        <p class="pq-subtext">
          Log every U.S. national park you've visited, plan the next one, collect
          stamps and badges, and bring your friends along.
        </p>
        <div class="pq-hero-links">
          <a href="https://parkquest.me/download" target="_blank" rel="noopener noreferrer" class="pq-badge">Available now on iOS</a>
          <a href="https://parkquest.me" target="_blank" rel="noopener noreferrer" class="pq-link">parkquest.me &rarr;</a>
        </div>
      </div>

      <svg class="pq-scroll-cue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </section>

    <!-- Origin story -->
    <section class="pq-section pq-origin">
      <div class="pq-origin-grid">
        <div class="pq-origin-text">
          <h2>The idea</h2>
          <p>
            After graduating from Tufts this past spring, two high school friends and I set out on a
            post-grad road trip to see all nine California national parks. Somewhere between
            trailheads, our tracking was scattered across notes apps and camera rolls &mdash; there
            wasn't a real way to log what we'd actually seen.
          </p>
          <p>
            ParkQuest is the fix: a proper log for all 63 U.S. national parks, built to track visits,
            see progress on a map, and compare notes with the people you explore with.
          </p>
        </div>
        <div class="pq-origin-map">
          <!-- California outline, simplified from the state's actual coastline
               (Wikimedia Commons, Map_of_California_outline.svg) rather than a
               hand-drawn approximation. -->
          <svg viewBox="0 0 300 345" aria-hidden="true">
            <path
              d="M 8.1,0.0 L 122.4,2.5 L 122.6,111.4 L 283.3,251.8 L 283.6,256.5 L 288.8,261.9 L 292.0,271.1 L 298.3,274.5 L 300.0,277.6 L 291.3,284.5 L 288.5,290.4 L 289.6,304.0 L 286.5,309.1 L 283.8,310.0 L 285.7,314.9 L 285.1,321.4 L 292.6,325.3 L 290.8,333.4 L 211.7,344.9 L 208.3,339.2 L 210.1,338.9 L 212.0,342.5 L 211.7,339.9 L 208.9,337.8 L 207.8,340.1 L 208.8,335.5 L 207.5,336.8 L 206.6,334.5 L 206.4,327.6 L 200.2,317.2 L 186.8,306.4 L 187.6,304.9 L 186.2,306.6 L 179.8,300.6 L 175.3,300.8 L 175.1,303.2 L 171.4,301.9 L 171.9,298.4 L 167.8,291.5 L 159.2,292.7 L 149.4,289.2 L 144.7,283.1 L 136.2,278.0 L 126.7,278.2 L 118.8,275.9 L 109.3,276.9 L 103.8,272.5 L 103.9,251.8 L 97.0,248.6 L 98.3,244.4 L 96.6,240.8 L 84.9,232.4 L 78.5,220.1 L 66.9,208.8 L 64.9,198.8 L 66.1,196.7 L 68.6,197.4 L 71.1,190.4 L 67.3,184.8 L 61.4,185.0 L 54.8,179.1 L 49.8,163.9 L 50.2,154.9 L 53.0,153.9 L 54.1,161.3 L 62.1,167.1 L 65.1,166.8 L 61.7,165.3 L 58.8,155.9 L 55.5,154.1 L 56.1,150.9 L 52.8,148.4 L 54.6,146.7 L 64.5,145.1 L 73.8,147.2 L 76.5,143.8 L 76.6,146.8 L 77.5,144.9 L 79.0,147.1 L 79.2,145.6 L 82.2,146.0 L 76.6,143.5 L 71.4,146.0 L 74.9,140.9 L 71.1,145.1 L 67.2,145.4 L 63.6,142.4 L 65.3,140.5 L 60.6,145.6 L 57.3,142.9 L 57.1,138.1 L 56.0,140.3 L 58.0,144.6 L 53.7,141.5 L 51.0,142.9 L 51.3,153.3 L 44.3,150.3 L 38.5,145.5 L 38.5,143.3 L 37.4,147.0 L 35.8,146.8 L 38.1,141.1 L 36.9,137.8 L 41.5,143.5 L 38.9,138.6 L 16.8,112.5 L 18.0,107.7 L 14.6,96.8 L 16.6,89.4 L 14.7,79.3 L 7.8,69.0 L 1.0,63.1 L 0.0,56.6 L 5.4,45.2 L 5.6,47.9 L 6.9,43.6 L 9.6,42.6 L 7.8,41.3 L 5.5,44.9 L 9.0,36.7 L 7.9,31.7 L 11.7,17.2 L 6.4,7.9 L 8.1,0.2 Z"
              fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5"
            />
            <g stroke="currentColor" stroke-width="1.2" opacity="0.7" fill="none">
              <path d="M 20,15 L 80,45 L 140,140 L 160,175 L 195,220 L 220,280 L 115,325" stroke-dasharray="3 5" />
            </g>
            <g fill="currentColor">
              <circle cx="20" cy="15" r="3.5" />
              <circle cx="80" cy="45" r="3.5" />
              <circle cx="140" cy="140" r="3.5" />
              <circle cx="160" cy="175" r="3.5" />
              <circle cx="195" cy="220" r="3.5" />
              <circle cx="220" cy="280" r="3.5" />
              <circle cx="115" cy="325" r="3.5" />
            </g>
          </svg>
          <p class="pq-map-caption">The route &mdash; 9 California national parks, one trip.</p>
        </div>
      </div>
    </section>

    <!-- What's inside -->
    <section class="pq-section pq-inside">
      <h2>What's inside</h2>
      <div class="pq-inside-grid">
        <div class="pq-inside-card">
          <svg class="pq-inside-icon" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.5" />
            <path d="M20 8 L20 20 L28 26" stroke="currentColor" stroke-width="1.6" fill="none" opacity="0.9" />
          </svg>
          <h3>Track every park</h3>
          <p>All 63 U.S. national parks on one map &mdash; visited, unvisited, and what's next.</p>
        </div>
        <div class="pq-inside-card">
          <svg class="pq-inside-icon" viewBox="0 0 40 40" aria-hidden="true">
            <rect x="6" y="8" width="28" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.5" />
            <line x1="6" y1="15" x2="34" y2="15" stroke="currentColor" stroke-width="1.4" opacity="0.5" />
            <circle cx="14" cy="23" r="2" fill="currentColor" opacity="0.9" />
            <circle cx="22" cy="23" r="2" fill="currentColor" opacity="0.5" />
            <circle cx="30" cy="23" r="2" fill="currentColor" opacity="0.5" />
          </svg>
          <h3>Plan your next trip</h3>
          <p>Queue up parks you want to see next and turn "someday" into an itinerary.</p>
        </div>
        <div class="pq-inside-card">
          <svg class="pq-inside-icon" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.5" stroke-dasharray="2 3" />
            <path d="M14 20 L18 24 L27 14" stroke="currentColor" stroke-width="1.8" fill="none" opacity="0.9" />
          </svg>
          <h3>Collect stamps &amp; badges</h3>
          <p>Earn a digital stamp for every visit and unlock badges as your log fills in.</p>
        </div>
        <div class="pq-inside-card">
          <svg class="pq-inside-icon" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="14" cy="16" r="5" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.6" />
            <circle cx="27" cy="16" r="5" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
            <path d="M6 32 C6 25 11 22 14 22 C17 22 22 25 22 32" stroke="currentColor" stroke-width="1.4" fill="none" opacity="0.6" />
            <path d="M19 32 C19 25 24 22 27 22 C30 22 35 25 35 32" stroke="currentColor" stroke-width="1.4" fill="none" opacity="0.4" />
          </svg>
          <h3>Compare with friends</h3>
          <p>See who's ahead on the leaderboard and turn tracking parks into friendly competition.</p>
        </div>
      </div>
    </section>

    <!-- Pinned feature scroller -->
    <section id="pq-feature-section" class="pq-section pq-features">
      <div class="pq-feature-grid">
        <div class="pq-phone-stage">
          <div class="pq-phone">
            <div class="pq-phone-notch"></div>
            <div class="pq-phone-screen">
              <div class="pq-screen pq-screen-1" data-pq-screen="1">
                <p class="pq-screen-label">Map</p>
                <svg viewBox="0 0 220 380" class="pq-screen-svg">
                  <rect x="10" y="10" width="200" height="360" rx="14" fill="none" stroke="currentColor" opacity="0.3" />
                  <g fill="currentColor">
                    <circle cx="60" cy="90" r="5" opacity="0.9" />
                    <circle cx="120" cy="70" r="5" opacity="0.3" />
                    <circle cx="150" cy="140" r="5" opacity="0.9" />
                    <circle cx="90" cy="180" r="5" opacity="0.3" />
                    <circle cx="140" cy="230" r="5" opacity="0.9" />
                    <circle cx="70" cy="270" r="5" opacity="0.3" />
                    <circle cx="130" cy="310" r="5" opacity="0.9" />
                  </g>
                  <text x="20" y="350" fill="currentColor" font-size="11" opacity="0.6">37 / 63 parks visited</text>
                </svg>
              </div>
              <div class="pq-screen pq-screen-2" data-pq-screen="2">
                <p class="pq-screen-label">Log a visit</p>
                <svg viewBox="0 0 220 380" class="pq-screen-svg">
                  <rect x="10" y="10" width="200" height="360" rx="14" fill="none" stroke="currentColor" opacity="0.3" />
                  <text x="24" y="50" fill="currentColor" font-size="14" opacity="0.85">Yosemite</text>
                  <rect x="24" y="70" width="172" height="90" rx="6" fill="none" stroke="currentColor" opacity="0.5" />
                  <line x1="24" y1="185" x2="196" y2="185" stroke="currentColor" opacity="0.4" />
                  <line x1="24" y1="210" x2="196" y2="210" stroke="currentColor" opacity="0.4" />
                  <line x1="24" y1="235" x2="140" y2="235" stroke="currentColor" opacity="0.4" />
                  <rect x="24" y="300" width="172" height="34" rx="8" fill="currentColor" opacity="0.25" />
                  <text x="110" y="322" fill="currentColor" font-size="11" text-anchor="middle" opacity="0.85">Save visit</text>
                </svg>
              </div>
              <div class="pq-screen pq-screen-3" data-pq-screen="3">
                <p class="pq-screen-label">Compare</p>
                <svg viewBox="0 0 220 380" class="pq-screen-svg">
                  <rect x="10" y="10" width="200" height="360" rx="14" fill="none" stroke="currentColor" opacity="0.3" />
                  <text x="24" y="45" fill="currentColor" font-size="13" opacity="0.85">Leaderboard</text>
                  <g stroke="currentColor" opacity="0.4">
                    <line x1="24" y1="70" x2="196" y2="70" />
                    <line x1="24" y1="110" x2="196" y2="110" />
                    <line x1="24" y1="150" x2="196" y2="150" />
                    <line x1="24" y1="190" x2="196" y2="190" />
                  </g>
                  <text x="24" y="95" fill="currentColor" font-size="11" opacity="0.85">1. Dan &mdash; 37 parks</text>
                  <text x="24" y="135" fill="currentColor" font-size="11" opacity="0.6">2. Sam &mdash; 29 parks</text>
                  <text x="24" y="175" fill="currentColor" font-size="11" opacity="0.6">3. Jordan &mdash; 22 parks</text>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <div class="pq-captions">
          <div class="pq-caption pq-caption-1" data-pq-caption="1">
            <h3>Track all 63 parks</h3>
            <p>See every U.S. national park on one map &mdash; visited, unvisited, and what's next.</p>
          </div>
          <div class="pq-caption pq-caption-2" data-pq-caption="2">
            <h3>Log each visit</h3>
            <p>Quick entries for dates, notes, and photos &mdash; right after you're off the trail.</p>
          </div>
          <div class="pq-caption pq-caption-3" data-pq-caption="3">
            <h3>Compare with friends</h3>
            <p>See who's ahead and turn tracking parks into a bit of a competition.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- By the numbers -->
    <section class="pq-section pq-stats">
      <div class="pq-stats-grid">
        <div class="pq-stat">
          <p class="pq-stat-num">63</p>
          <p class="pq-stat-label">U.S. national parks tracked</p>
        </div>
        <div class="pq-stat">
          <p class="pq-stat-num">9</p>
          <p class="pq-stat-label">Parks on the trip that started it</p>
        </div>
        <div class="pq-stat">
          <p class="pq-stat-num">2026</p>
          <p class="pq-stat-label">Launch year</p>
        </div>
        <div class="pq-stat">
          <p class="pq-stat-num">iOS + Web</p>
          <p class="pq-stat-label">Native app, plus parkquest.me</p>
        </div>
      </div>
    </section>

    <!-- Built with -->
    <section class="pq-section pq-bts">
      <h2>Built with</h2>
      <div class="pq-diagram">
        <svg viewBox="0 0 900 220" class="pq-diagram-svg" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.55">
            <rect x="20" y="80" width="180" height="60" rx="6" />
            <rect x="290" y="80" width="140" height="60" rx="6" />
            <rect x="520" y="80" width="220" height="60" rx="6" />
            <rect x="520" y="20" width="220" height="40" rx="6" opacity="0.4" />
            <line x1="200" y1="110" x2="290" y2="110" />
            <line x1="430" y1="110" x2="520" y2="110" />
            <line x1="630" y1="80" x2="630" y2="60" opacity="0.4" />
          </g>
          <g fill="currentColor" opacity="0.85" font-size="13">
            <text x="110" y="115" text-anchor="middle">Native iOS App</text>
            <text x="360" y="115" text-anchor="middle">Node.js API</text>
            <text x="630" y="115" text-anchor="middle">PostgreSQL + Drizzle</text>
            <text x="630" y="45" text-anchor="middle" opacity="0.7">63-park geodata &amp; map tiles</text>
          </g>
        </svg>
      </div>
      <ul class="pq-stack-badges">
        <li>Swift &amp; SwiftUI</li>
        <li>React</li>
        <li>TypeScript</li>
        <li>Node.js</li>
        <li>Leaflet</li>
        <li>PostgreSQL</li>
        <li>Drizzle ORM</li>
      </ul>
      <ul class="pq-notes">
        <li>Type-safe schema and migrations via Drizzle ORM instead of hand-written SQL.</li>
        <li>Park boundaries and visit map rendered from a dedicated 63-park geodata set, with Leaflet powering the web map.</li>
        <li>A companion web app at parkquest.me, built with React and TypeScript, mirrors the same tracking for desktop.</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="pq-section pq-cta">
      <div class="pq-cta-fade-top" aria-hidden="true"></div>
      <div class="pq-cta-fade-bottom" aria-hidden="true"></div>
      <div class="pq-cta-bg" aria-hidden="true"></div>
      <div class="pq-cta-inner">
        <Image src={parkquestLogo} alt="ParkQuest app icon" class="pq-app-icon pq-app-icon-small" width={200} height={200} />
        <h2>Try it yourself</h2>
        <p class="pq-cta-copy">The ParkQuest app is available now on iOS, free to download.</p>
        <div class="pq-cta-store">
          <a href="https://parkquest.me/download" target="_blank" rel="noopener noreferrer" class="pq-store-badge">
            <img src="/badges/app-store-badge.svg" alt="Download on the App Store" width="160" height="47" />
          </a>
          <a href="https://parkquest.me" target="_blank" rel="noopener noreferrer" class="pq-cta-web-link">or start on the web &rarr;</a>
        </div>
        <div class="pq-cta-links">
          <a href="https://github.com/danglorioso/park-quest" target="_blank" rel="noopener noreferrer" class="pq-link">View source &rarr;</a>
        </div>
        <a href="/projects" class="pq-back">&larr; Back to all projects</a>
      </div>
    </section>
  </div>
</Showcase>

<style>
  .pq-page {
    /* ParkQuest brand palette — scoped to this page only, kept separate
       from the site's global blue --accent-primary. */
    --pq-bg-0: #0b160f;
    --pq-bg-1: #13261a;
    --pq-bg-2: #1c3524;
    --pq-gold: #d7a955;
    --pq-gold-soft: #e8c37e;
    --pq-cream: #f3efe2;
    --pq-mute: #a8bcac;
  }

  section.pq-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 2rem;
    background: linear-gradient(180deg, var(--pq-bg-1) 0%, var(--pq-bg-0) 65%, #060b08 100%);
    color: var(--pq-mute);
  }

  .pq-hero-glow {
    position: absolute;
    top: 8%;
    right: 12%;
    width: 32rem;
    height: 32rem;
    background: radial-gradient(circle, rgba(224, 165, 63, 0.35) 0%, rgba(224, 165, 63, 0) 70%);
    filter: blur(10px);
    pointer-events: none;
  }

  .pq-hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 14rem;
    background: linear-gradient(to bottom, transparent, var(--bg-primary));
    pointer-events: none;
  }

  .pq-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--pq-gold-soft);
  }
  .pq-star {
    --pq-star-max: 0.6;
    animation-name: pq-twinkle;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .pq-star-1  { --pq-star-max: 0.7;  animation-duration: 4.2s; animation-delay: 0s; }
  .pq-star-2  { --pq-star-max: 0.5;  animation-duration: 6.1s; animation-delay: 1.1s; }
