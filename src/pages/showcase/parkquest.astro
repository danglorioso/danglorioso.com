<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initParkQuestHero() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    const content = document.querySelector(".pq-hero-content");
    if (!content) return;
    const targets = [
      content.querySelector(".pq-app-icon"),
      content.querySelector(".pq-eyebrow"),
      content.querySelector(".pq-title"),
      content.querySelector(".pq-tagline"),
      content.querySelector(".pq-subtext"),
      content.querySelector(".pq-hero-links"),
    ].filter(Boolean);
    if (!targets.length) return;

    gsap.set(content, { opacity: 1 });
    gsap.from(targets, {
      y: 22,
      opacity: 0,
      duration: 0.7,
      ease: "power2.out",
      stagger: 0.1,
      delay: 0.15,
    });
  }

  function initParkQuestScroll() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    const mm = gsap.matchMedia();

    // Runs at every width now — previously gated to 900px+, which meant
    // narrower viewports never advanced past screen 1 at all. GSAP's pin
    // doesn't depend on the CSS sticky rule (that's only for a visual nudge
    // at 900px+), so it works fine full-width on mobile too.
    mm.add("(min-width: 0px)", () => {
      const section = document.getElementById("pq-feature-section");
      const grid = document.querySelector<HTMLElement>(".pq-feature-grid");
      const stage = document.querySelector<HTMLElement>(".pq-phone-stage");
      const captionsStage = document.querySelector<HTMLElement>(".pq-captions-stage");
      const dotsStage = document.querySelector<HTMLElement>(".pq-slide-dots");
      const phone = document.querySelector<HTMLElement>(".pq-phone");
      const screens = gsap.utils.toArray<HTMLElement>(".pq-screen");
      const captions = gsap.utils.toArray<HTMLElement>(".pq-caption");
      if (!section || !grid || !stage || !captionsStage || !phone || screens.length < 3 || captions.length !== screens.length) return;

      // Below 900px the grid is a single stacked column (phone above
      // captions), not side-by-side — pinning the phone and captions as
      // two independent elements (as below) freezes each wherever it
      // naturally sits, and the captions column's natural spot is a full
      // phone-height below the phone, well outside the viewport. That left
      // mobile scrolling through a pinned phone with nothing but empty
      // background beneath it, then dumping all the caption text into view
      // at once only once the pin released. Below 900px, pin the *grid*
      // itself instead — one element, phone and captions both riding along
      // inside it — so the caption is always on-screen with the phone.
      const isSideBySide = window.matchMedia("(min-width: 900px)").matches;
      const pinTarget = isSideBySide ? stage : grid;

      // Captions now overlap and crossfade in place (like the phone's own
      // screens) instead of stacking in normal flow with a scroll-position-
      // dependent reveal — so the active one can always be centered
      // regardless of how much text it holds. Side-by-side, match its
      // stage's height to the phone's real rendered height so both land at
      // the same pinned top offset and end up centered together, not just
      // independently.
      if (isSideBySide) {
        captionsStage.style.height = phone.offsetHeight + "px";
      } else {
        // Stacked on mobile, the phone and captions ride together inside
        // one pinned block (pinTarget === grid) that can't be taller than
        // the viewport below the header, or the captions half gets pushed
        // out of view for the whole pin — the CSS `24vh`-capped width on
        // .pq-phone is only a rough guess and isn't guaranteed to leave
        // room for the captions box on every device. Measure the real
        // numbers instead: give captions their natural (CSS min-height)
        // size, then size the phone to exactly whatever's left, so the
        // total always fits by construction rather than by estimate.
        const headerH = document.getElementById("main-header")?.offsetHeight ?? 0;
        const availableH = window.innerHeight - headerH;
        const gridStyles = getComputedStyle(grid);
        const paddingV = parseFloat(gridStyles.paddingTop) + parseFloat(gridStyles.paddingBottom);
        const gapV = parseFloat(gridStyles.rowGap || gridStyles.gap) || 0;
        const captionsH = captionsStage.getBoundingClientRect().height;
        const naturalPhoneH = phone.getBoundingClientRect().height;
        const maxPhoneH = availableH - paddingV - gapV - captionsH;
        // Never shrink below a legible floor (~68px wide at this aspect
        // ratio) — on a device short enough to hit that floor, the block
        // will end up slightly taller than the viewport and the pin's
        // top-clamped start (see computeStart below) will let the bottom
        // run a little past the fold, which is still far better than the
        // captions being pushed off entirely.
        const phoneH = Math.max(140, Math.min(maxPhoneH, naturalPhoneH));
        phone.style.height = phoneH + "px";
        phone.style.width = "auto";
      }

      gsap.set(screens, { autoAlpha: 0 });
      gsap.set(screens[0], { autoAlpha: 1 });
      // Captions stay fully opaque always — visibility is handled purely by
      // vertical position plus .pq-captions' overflow:hidden clip below, so
      // the transition is a physical slide with no opacity blend muddying
      // where each caption actually is.
      gsap.set(captions, { autoAlpha: 1, yPercent: 100 });
      gsap.set(captions[0], { yPercent: 0 });

      // GSAP's pin captures the element wherever it naturally sits in the
      // layout the instant the trigger fires (position:fixed with that
      // measured top baked in) — it ignores CSS sticky/top entirely. To
      // center the pinned block in the viewport, solve for the
      // section-scroll offset that makes *pinTarget* land at vertical
      // center, rather than an arbitrary fixed value.
      const computeStart = () => {
        const targetRect = pinTarget.getBoundingClientRect();
        const sectionRect = section.getBoundingClientRect();
        const offsetWithinSection = targetRect.top - sectionRect.top;
        // Center within the space below the site header (it goes fixed on
        // scroll-up), not the raw viewport, so the pinned phone never sits
        // underneath/behind it. No extra buffer here — adding one on top
        // of headerH would make the gap above the phone bigger than the
        // gap below it; centering against the header's true edge is what
        // keeps both gaps equal. Clamped at 0: the stacked mobile block
        // (phone + gap + captions) can be taller than the viewport, where
        // the unclamped math goes negative and pushes the top of the pin
        // up behind the header instead of just running off the bottom.
        const headerH = document.getElementById("main-header")?.offsetHeight ?? 0;
        const desiredViewportTop = headerH + Math.max(0, (window.innerHeight - headerH - targetRect.height) / 2);
        return "top top+=" + (desiredViewportTop - offsetWithinSection);
      };
      // Shorter now (was 700px, then 400px/transition) — each cut made the
      // full sequence lighter to scroll through; paired with the wider
      // caption blend window above, this makes the slide track the wheel
      // almost immediately instead of needing a long haul per screen.
      const end = "+=" + (screens.length - 1) * 280;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: computeStart,
          end,
          scrub: 0.6,
          pin: pinTarget,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      // Side-by-side (900px+) only: ScrollTrigger's `pin` only reliably
      // pins one target per instance — an array didn't do what it sounds
      // like it should, so the captions column gets its own pin alongside
      // the phone's. Reading `start` off the *already-resolved* value on
      // the main trigger (instead of calling computeStart() a second time)
      // guarantees byte-identical sync — two independent calls landing a
      // pixel apart was the likely cause of the double-snap/jerk when this
      // section first engages. Stacked on mobile there's nothing to
      // duplicate here — pinTarget (the whole grid) already carries the
      // captions along with it.
      if (isSideBySide) {
        ScrollTrigger.create({
          trigger: section,
          start: () => tl.scrollTrigger?.start ?? computeStart(),
          end,
          pin: captionsStage,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        });
      }

      // Videos play once and freeze on the last frame (no `loop`) — an
      // Apple-style "Replay" link surfaces below the mockup once the
      // active screen's video ends, and hides again the moment a new
      // screen becomes active.
      const replayBtn = document.getElementById("pq-replay");
      const hideReplay = () => replayBtn?.classList.remove("is-visible");
      const showReplay = () => replayBtn?.classList.add("is-visible");

      // Restart a screen's video from the beginning whenever it becomes the
      // active one, instead of leaving it wherever it stopped (or, worse,
      // paused/needing a manual play — browsers can stop an autoplaying
      // video that's been visibility:hidden for a while).
      const restartVideo = (screen: HTMLElement) => {
        hideReplay();
        const video = screen.querySelector<HTMLVideoElement>("video");
        if (!video) return;
        video.currentTime = 0;
        video.play().catch(() => {});
      };

      // Every screen with a video gets its own replay affordance — surfaces
      // whenever THAT screen's video plays through while it's the active
      // one. (A background screen's video can also fire `ended` while
      // hidden, since it isn't paused when its screen goes inactive — the
      // visibility check guards against that.)
      screens.forEach((screen) => {
        const video = screen.querySelector<HTMLVideoElement>("video");
        video?.addEventListener("ended", () => {
          if (getComputedStyle(screen).visibility === "hidden") return;
          showReplay();
        });
      });
      replayBtn?.addEventListener("click", () => {
        const activeScreen = screens.find(
          (s) => getComputedStyle(s).visibility !== "hidden"
        );
        if (activeScreen) restartVideo(activeScreen);
      });

      // Keeps the "keep scrolling" hint glued right under whichever
      // caption's text is currently active — captions vary a lot in
      // length and are vertically centered in a fixed-height box, so
      // their own bottom edge lands somewhere different every time.
      const hint = document.getElementById("pq-keep-scrolling");
      const positionHint = () => {
        if (!hint) return;
        // Captions are always visibility:visible now (the slide/detent
        // effect below is driven by position, not opacity), so "active"
        // can't be read off computed visibility anymore — instead pick
        // whichever caption's box currently sits flush with the stage's
        // own top (yPercent 0), which is only ever true for the one
        // that's fully settled in place.
        const stageRect = captionsStage.getBoundingClientRect();
        let activeCaption = captions[0];
        let minDist = Infinity;
        for (const c of captions) {
          const dist = Math.abs(c.getBoundingClientRect().top - stageRect.top);
          if (dist < minDist) {
            minDist = dist;
            activeCaption = c;
          }
        }
        const p = activeCaption.querySelector("p");
        if (!p) return;
        const pRect = p.getBoundingClientRect();
        const gap = 48;
        hint.style.top = pRect.bottom - stageRect.top + gap + "px";
      };
      positionHint();

      // Screens still get a quick crossfade window; captions get a much
      // wider one so the slide tracks the scroll wheel almost immediately
      // instead of sitting through a long dead zone before it starts
      // moving. blendDuration (the caption one) also drives the snap/dot/
      // hint logic below, since it's the longer of the two — anything
      // still mid-caption-slide is also, trivially, past the screen's
      // already-finished crossfade.
      const screenBlendDuration = 0.08;
      const blendDuration = 0.15;
      const blendStarts: number[] = [];
      for (let i = 1; i < screens.length; i++) {
        const frac = i / (screens.length - 1);
        blendStarts.push(frac);
        // Linear on purpose: this timeline is scrubbed by scroll position,
        // not played back on its own clock, so an eased ease would make
        // opacity/position cross the midpoint at some time other than the
        // tween's own midpoint — throwing off the mid-blend snap logic
        // below, which picks a side by comparing tl.time() to that
        // midpoint.
        //
        // Captions slide instead of crossfading (a magic-8-ball reel: the
        // outgoing caption rides up and off the top, the incoming one
        // rides up from below into place) so scrubbing back and forth
        // shows physical travel toward a detent, rather than an opacity
        // blend that gives no sense of "how close" the next slide is.
        tl.to(screens[i - 1], { autoAlpha: 0, duration: screenBlendDuration, ease: "none" }, frac)
          .to(screens[i], { autoAlpha: 1, duration: screenBlendDuration, ease: "none", onStart: () => restartVideo(screens[i]) }, frac)
          .to(captions[i - 1], { yPercent: -100, duration: blendDuration, ease: "none" }, frac)
          .to(captions[i], { yPercent: 0, duration: blendDuration, ease: "none", onComplete: positionHint }, frac);
      }

      // Vertical dot stack mirrors the active caption index — recomputed
      // from the timeline's own scrubbed time on every update (not tied to
      // individual tween callbacks) so it stays correct scrolling in
      // either direction.
      const dots = gsap.utils.toArray<HTMLElement>(".pq-slide-dot");
      const updateActiveDot = () => {
        // Fixed to the viewport edge rather than pinned inline (see the
        // CSS), so it needs its own visibility toggle — only relevant
        // while the phone/caption pin is actually engaged.
        dotsStage?.classList.toggle("is-visible", !!tl.scrollTrigger?.isActive);
        if (!dots.length) return;
        const t = tl.time();
        let idx = 0;
        for (let i = 0; i < blendStarts.length; i++) {
          if (t >= blendStarts[i] + blendDuration / 2) idx = i + 1;
        }
        dots.forEach((d, i) => d.classList.toggle("is-active", i === idx));
      };
      tl.eventCallback("onUpdate", updateActiveDot);
      // ScrollTrigger.refresh() (see the video-metadata handling below)
      // briefly rewinds every trigger's animation to time 0 to remeasure,
      // firing this same onUpdate with a spurious t=0 — then restores the
      // real position through a render that doesn't fire onUpdate again,
      // leaving the dot stuck on index 0 until the next scroll. Resyncing
      // once the refresh cycle actually finishes corrects it.
      ScrollTrigger.addEventListener("refresh", updateActiveDot);
      updateActiveDot();

      // Scrubbing ties the crossfade directly to scroll position, so a
      // user can stop scrolling mid-blend and be left looking at two
      // half-visible screens at once. On scrollend, if we're inside one
      // of those blend windows, snap forward/back to whichever screen's
      // fully-settled edge is closer — never leave the fade caught
      // mid-way. `scrollend` (not a debounce timer) waits out the
      // browser's own momentum/inertial scroll before checking.
      // A programmatic smooth-scroll (from here or the click-to-advance
      // handler below) can fire more than one 'scrollend' before it's
      // actually finished — WebKit seems to emit one at each momentary
      // pause in the animation curve, not just at the true end. A single
      // consume-once flag only absorbs the first of those and lets a
      // later spurious one fire trySnap's real logic mid-flight, snapping
      // the page backward before the scroll it was supposed to ignore
      // even finishes. A time window survives however many fire.
      let suppressSnapUntil = 0;
      const suppressSnapFor = (ms: number) => {
        suppressSnapUntil = Date.now() + ms;
      };
      // Self-driven instead of `window.scrollTo({behavior:"smooth"})` — the
      // native version was observed cutting itself short mid-animation on
      // some transitions here (landing dozens of px before the requested
      // target, for reasons that didn't trace back to anything in this
      // file). Driving it via rAF sidesteps whatever native scroll-
      // animation cancellation was doing that, and lets one duration cover
      // the whole suppression window precisely.
      const animateScrollTo = (target: number, duration = 500) => {
        const startY = window.scrollY;
        const delta = target - startY;
        if (Math.abs(delta) < 1) return;
        const startTime = performance.now();
        const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
        const step = (now: number) => {
          const t = Math.min(1, (now - startTime) / duration);
          window.scrollTo(0, startY + delta * easeOutCubic(t));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const trySnap = () => {
        if (Date.now() < suppressSnapUntil) return;
        const st = tl.scrollTrigger;
        if (!st || !st.isActive) return;
        const t = tl.time();
        for (const bStart of blendStarts) {
          const bEnd = bStart + blendDuration;
          if (t <= bStart || t >= bEnd) continue;
          const mid = bStart + blendDuration / 2;
          const targetTime = t < mid ? bStart : bEnd;
          const targetProgress = targetTime / tl.duration();
          // Nudge 1px past the exact edge — landing precisely on it can
          // round to a fraction of a pixel short, leaving autoAlpha at
          // 99.x% instead of a clean 0/1.
          const edgeBuffer = targetTime === bStart ? -1 : 1;
          const targetScrollY = st.start + targetProgress * (st.end - st.start) + edgeBuffer;
          suppressSnapFor(600);
          animateScrollTo(targetScrollY);
          return;
        }
      };
      window.addEventListener("scrollend", trySnap);

      // The idle hint doubles as a "next" control — click it to advance
      // to the next screen's settled point, or (on the last screen) jump
      // straight to the carousel section below, since there's nothing
      // further to advance to within the pin itself.
      hint?.addEventListener("click", () => {
        // Ignore clicks while a previous click's (or the auto-snap's)
        // smooth-scroll is still in flight — starting a second one on top
        // reads the still-mid-transition screen as "active" and can
        // compute a target that doesn't actually advance anything.
        if (Date.now() < suppressSnapUntil) return;
        const st = tl.scrollTrigger;
        if (!st) return;
        const activeIndex = screens.findIndex(
          (s) => getComputedStyle(s).visibility !== "hidden"
        );
        if (activeIndex === -1) return;
        if (activeIndex >= blendStarts.length) {
          document
            .querySelector(".pq-carousel-section")
            ?.scrollIntoView({ behavior: "smooth" });
          return;
        }
        const targetTime = blendStarts[activeIndex] + blendDuration;
        const targetProgress = targetTime / tl.duration();
        // Same 1px-past-the-edge nudge as the auto-snap above — landing
        // precisely on the boundary can round a fraction short, leaving
        // the next screen at 99.x% instead of a clean 100%.
        const targetScrollY = st.start + targetProgress * (st.end - st.start) + 1;
        suppressSnapFor(600);
        animateScrollTo(targetScrollY);
      });

      // Nudge the user to keep scrolling if they pause mid-sequence for a
      // second — reassurance that the pinned section is still responding,
      // not stuck. Still fires on the last screen too: there's more page
      // below (the carousel), so "done with this section" still means
      // "keep scrolling."
      let idleTimer: ReturnType<typeof setTimeout> | undefined;
      let lastScrollY = window.scrollY;
      const onScroll = () => {
        if (!hint) return;
        // Some browsers fire a trailing 'scroll' event or two with no
        // actual position change (momentum settling, etc.) — treat those
        // as no-ops instead of letting them keep resetting the idle timer
        // right as it's about to arm.
        if (window.scrollY === lastScrollY) return;
        lastScrollY = window.scrollY;
        hint.classList.remove("is-visible");
        clearTimeout(idleTimer);
        const st = tl.scrollTrigger;
        if (!st) return;
        // GSAP flips `isActive` false the instant scroll passes the pin's
        // end — the same tick `progress` reaches 1 — so there's no moment
        // where both "isActive" and "resting on the last screen" are true
        // together. A fixed pixel buffer past `end` doesn't work either:
        // one scroll step can easily overshoot it by more than any static
        // amount. Checking the section's own visibility instead is robust
        // regardless of how fast/far a single scroll tick travels.
        const justPastEnd = st.progress >= 1 && section.getBoundingClientRect().bottom > 0;
        if (!(st.isActive || justPastEnd) || st.progress <= 0) return;
        idleTimer = setTimeout(() => hint.classList.add("is-visible"), 1000);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", positionHint);

      return () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", positionHint);
        window.removeEventListener("scrollend", trySnap);
        clearTimeout(idleTimer);
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    });
  }

  function initParkQuestScrollCue() {
    const btn = document.getElementById("pq-scroll-cue");
    const target = document.getElementById("pq-origin-section");
    if (!btn || !target) return;
    btn.addEventListener("click", () => {
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function initParkQuestMedia() {
    // Browsers suppress the `autoplay` attribute on elements that are
    // visibility:hidden at load (our non-default pq-screen panels are), and
    // GSAP toggling visibility later doesn't retroactively trigger it — so
    // kick off playback manually instead of relying on the attribute.
    document
      .querySelectorAll<HTMLVideoElement>("video.pq-screen-media, .pq-mini-phone-screen video")
      .forEach((video) => {
        video.play().catch(() => {});
      });
  }

  function initParkQuestScrollRefresh() {
    // The pinned crossfade's trigger boundaries are computed against
    // whatever the page's layout height is at init time. Real screenshots
    // and video (unlike the old SVG placeholders) load asynchronously and
    // can shift that height afterward, leaving ScrollTrigger's cached
    // start/end stale — refresh once everything has actually settled.
    const media = Array.from(
      document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
        ".pq-screen-media"
      )
    );
    let pending = media.length;
    if (pending) {
      const done = () => {
        pending -= 1;
        if (pending <= 0) ScrollTrigger.refresh();
      };
      media.forEach((el) => {
        if (el instanceof HTMLImageElement) {
          if (el.complete) done();
          else el.addEventListener("load", done, { once: true });
        } else {
          if (el.readyState >= 1) done();
          else el.addEventListener("loadedmetadata", done, { once: true });
        }
      });
    }

    // The carousel's own screenshots are `loading="lazy"`, so they load in
    // waves as the user scrolls toward them rather than all at once —
    // without this, the carousel's own fan-out entrance trigger stayed
    // computed against a shorter, pre-load page and fired too early
    // (already fully visible by the time it actually scrolled into view).
    // Refresh — batched via rAF so 40+ near-simultaneous loads don't each
    // trigger their own recalculation — as each one settles.
    let carouselRefreshQueued = false;
    const queueCarouselRefresh = () => {
      if (carouselRefreshQueued) return;
      carouselRefreshQueued = true;
      requestAnimationFrame(() => {
        carouselRefreshQueued = false;
        ScrollTrigger.refresh();
      });
    };
    document
      .querySelectorAll<HTMLImageElement | HTMLVideoElement>(
        ".pq-mini-phone-screen img, .pq-mini-phone-screen video"
      )
      .forEach((el) => {
        if (el instanceof HTMLImageElement) {
          if (!el.complete) el.addEventListener("load", queueCarouselRefresh, { once: true });
        } else if (el.readyState < 1) {
          el.addEventListener("loadedmetadata", queueCarouselRefresh, { once: true });
        }
      });

    window.addEventListener("load", () => ScrollTrigger.refresh());
  }

  function initParkQuestCarousel() {
    const phones = gsap.utils.toArray<HTMLElement>(".pq-mini-phone");
    if (!phones.length) return;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    // Fans out from a stacked/tilted starting point as the carousel scrolls
    // into view — picks up the "coming out of the single phone" feeling
    // without literally morphing that DOM element. Tied to scroll position
    // (scrub) rather than played once on a time-based tween: this section
    // isn't pinned, so a normal fast scroll/flick easily covers its whole
    // trigger range before an untied ~1-3.5s animation could finish,
    // making it look like the phones were "already there." Scrubbing keeps
    // the reveal in lockstep with scroll no matter how fast that is.
    gsap.from(phones, {
      opacity: 0,
      x: -60,
      rotate: -8,
      scale: 0.82,
      stagger: 0.06,
      scrollTrigger: {
        trigger: ".pq-carousel-section",
        start: "top 85%",
        end: "top 35%",
        scrub: 0.4,
      },
    });
  }

  function initParkQuestDiagram() {
    const svg = document.querySelector<SVGSVGElement>(".pq-diagram-svg");
    if (!svg) return;
    const groupedEls = svg.querySelectorAll<SVGElement>("[data-group]");
    const allGroups = ["ios", "web", "neon", "clerk", "r2", "external"];

    const setActive = (groups: string[] | null) => {
      svg.classList.toggle("pq-diagram-hovering", groups !== null);
      groupedEls.forEach((el) => {
        if (!groups) {
          el.classList.remove("is-active");
          return;
        }
        const own = (el.dataset.group ?? "").split(" ");
        el.classList.toggle("is-active", own.some((g) => groups.includes(g)));
      });
    };

    svg.querySelectorAll<SVGRectElement>("[data-node]").forEach((hit) => {
      const node = hit.dataset.node ?? "";
      // The API box is the hub everything routes through — hovering it
      // spotlights the whole diagram rather than just itself.
      const groups = node === "api" ? allGroups : [node];
      hit.addEventListener("mouseenter", () => setActive(groups));
      hit.addEventListener("mouseleave", () => setActive(null));
    });
  }

  function initParkQuestApiExplorer() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".pq-api-tab");
    if (!tabs.length) return;
    const panes = document.querySelectorAll<HTMLElement>(".pq-api-pane");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.apiTab;
        tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
        panes.forEach((pane) => pane.classList.toggle("is-active", pane.dataset.apiPane === id));
      });
    });
  }

  function initParkQuestSuggestionGraph() {
    const visual = document.querySelector<HTMLElement>(".pq-algo-visual");
    if (!visual) return;

    const stages = ["all", "exclude", "signal", "rank"];
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      visual.dataset.stage = stages[stages.length - 1];
      return;
    }

    let i = 0;
    setInterval(() => {
      i = (i + 1) % stages.length;
      visual.dataset.stage = stages[i];
    }, 2200);
  }

  function initParkQuest() {
    initParkQuestHero();
    initParkQuestScroll();
    initParkQuestScrollCue();
    initParkQuestMedia();
    initParkQuestScrollRefresh();
    initParkQuestSuggestionGraph();
    initParkQuestCarousel();
    initParkQuestDiagram();
    initParkQuestApiExplorer();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initParkQuest);
  } else {
    initParkQuest();
  }
</script>
