const suggestionSteps = [
  {
    n: 1,
    title: "Exclusion set",
    desc: "One relationship query excludes self, existing friends, pending requests, and blocked users upfront. It checks both directions since friendships are undirected but stored as requester_id/recipient_id rows.",
  },
  {
    n: 2,
