  .pq-star-4  { --pq-star-max: 0.8;  animation-duration: 5.3s; animation-delay: 2.4s; }
  .pq-star-5  { --pq-star-max: 0.55; animation-duration: 4.8s; animation-delay: 0.3s; }
  .pq-star-6  { --pq-star-max: 0.65; animation-duration: 3.9s; animation-delay: 1.8s; }
  .pq-star-7  { --pq-star-max: 0.5;  animation-duration: 6.6s; animation-delay: 3.1s; }
  .pq-star-8  { --pq-star-max: 0.6;  animation-duration: 4.5s; animation-delay: 2s; }
