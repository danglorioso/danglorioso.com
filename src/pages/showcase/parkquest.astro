---
// "Flagship" product page for ParkQuest — an Apple-style scroll experience:
// full-bleed hero, pinned scroll-scrubbed feature demo (real App Store
// screenshots), and a blueprint-style architecture teardown.
//
// Color: this page defines its own green/gold palette (--pq-*) scoped to
// .pq-page, matching the parkquest.me brand, instead of the site's global
// blue --accent-primary — kept local so the rest of the portfolio is
// untouched.
import { Image } from "astro:assets";
import Showcase from "../../layouts/Showcase.astro";
import parkquestLogo from "../../content/projects/parkquest-logo.png";
// Real traced iPhone silhouette (reused from the blog's DeviceShowcase) — the
// body path has the screen area cut out via nonzero fill-rule, so it works as
// an overlay mask over whatever's positioned in .pq-phone-screen-hole below.
import iphoneOutline from "../../components/blog/iphone-trace.svg?raw";

// Deterministic shuffle (fixed seed) instead of Math.random() — this list is
// built once at build/render time, and a stable order avoids the row
// reshuffling itself on every rebuild or SSR request.
function seededShuffle<T>(arr: T[], seed: number): T[] {
  let state = seed;
  const rand = () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
  const out = [...arr];
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

// Phone carousel slides — mix of the original curated set (some video) and
// the full batch of real device screenshots, in one data-driven list so the
// track markup below doesn't repeat itself 40+ times. Order is randomized
// (see seededShuffle above) so it doesn't read as ~11 curated shots followed
// by ~32 raw dumps in upload order.
const carouselSlidesOrdered: { src: string; alt: string; video?: boolean }[] = [
  { src: "/showcase/parkquest/web/feed.jpg", alt: "ParkQuest social feed" },
  { src: "/showcase/parkquest/web/map.jpg", alt: "ParkQuest map" },
  { src: "/showcase/parkquest/web/map-grandcanyon.jpg", alt: "ParkQuest map, Grand Canyon" },
  { src: "/showcase/parkquest/web/profile-arches.jpg", alt: "Arches National Park detail" },
  { src: "/showcase/parkquest/web/profile-grandcanyon.jpg", alt: "Grand Canyon National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9687.jpg", alt: "ParkQuest feed, first visit to Grand Teton National Park" },
  { src: "/showcase/parkquest/web/carousel/img-9691.jpg", alt: "Grand Teton National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9692.jpg", alt: "Yellowstone National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9693.jpg", alt: "Acadia National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9694.jpg", alt: "Virgin Islands National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9695.jpg", alt: "Mount Rainier National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9696.jpg", alt: "Yosemite National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9697.jpg", alt: "Joshua Tree National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9698.jpg", alt: "Redwood National and State Parks detail" },
  { src: "/showcase/parkquest/web/carousel/img-9699.jpg", alt: "Shenandoah National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9700.jpg", alt: "New River Gorge National Park and Preserve detail" },
  { src: "/showcase/parkquest/web/carousel/img-9704.jpg", alt: "Explore the Parks grid" },
  { src: "/showcase/parkquest/web/carousel/img-9707.jpg", alt: "Browse the full parks list" },
  { src: "/showcase/parkquest/web/carousel/img-9708.jpg", alt: "Map view centered on Glacier National Park" },
  { src: "/showcase/parkquest/web/carousel/img-9709.jpg", alt: "Mount Rainier National Park detail from the map" },
  { src: "/showcase/parkquest/web/carousel/img-9710.jpg", alt: "Carlsbad Caverns National Park detail" },
  { src: "/showcase/parkquest/web/carousel/img-9711.jpg", alt: "Map view centered on Carlsbad Caverns National Park" },
  { src: "/showcase/parkquest/web/carousel/img-9712.jpg", alt: "Carlsbad Caverns National Park hours and activities" },
  { src: "/showcase/parkquest/web/carousel/img-9713.jpg", alt: "Isle Royale National Park directions" },
  { src: "/showcase/parkquest/web/carousel/img-9714.jpg", alt: "Logging a visit, trip dates and weather" },
  { src: "/showcase/parkquest/web/carousel/img-9715.jpg", alt: "Logging a visit, weather conditions step" },
  { src: "/showcase/parkquest/web/carousel/img-9716.jpg", alt: "Logging a visit, rating step" },
  { src: "/showcase/parkquest/web/carousel/img-9720.jpg", alt: "Death Valley National Park directions" },
  { src: "/showcase/parkquest/web/carousel/img-9722.jpg", alt: "Saguaro National Park entrance fees" },
  { src: "/showcase/parkquest/web/carousel/img-9723.jpg", alt: "Explore the Parks filters" },
  { src: "/showcase/parkquest/web/carousel/img-9725.jpg", alt: "Search parks on the map" },
];
const carouselSlides = seededShuffle(carouselSlidesOrdered, 20260801);
---

<Showcase
