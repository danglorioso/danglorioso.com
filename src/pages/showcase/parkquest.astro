// Node graph for the friend-suggestions visual: "you" at center, 14 people
// laid out by an actual force-directed relaxation (repulsion between every
// pair + spring pull along connections), the same family of algorithm real
// graph-drawing tools use — not a hand-placed ring, which reads as too
// symmetric (a wheel/logo) no matter how much per-node jitter gets added
// on top. Excluded ones (friend/pending/blocked) drop out in the
// "exclude" stage; the remaining candidates carry the mutual-friend and
// shared-park counts the real scoring formula uses (score = mutual*3 +
// shared*2), shown in the "signal" and "rank" stages.
const SUGG_SIZE = 480;
const SUGG_CENTER = SUGG_SIZE / 2;
const SUGG_YOU_R = 22;
const SUGG_NODE_R = 13;
function makeSeededRand(seed: number) {
  let state = seed;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
}
const suggRand = makeSeededRand(4111990);
// Trims a line segment so it stops at each circle's edge instead of its
// center — otherwise, when an edge fades in/out, it visibly pokes out
// from under (or into) the node instead of meeting its border cleanly.
function suggTrim(x1: number, y1: number, x2: number, y2: number, r1: number, r2: number) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const dist = Math.hypot(dx, dy) || 1;
  const ux = dx / dist;
  const uy = dy / dist;
  return {
    x1: Math.round((x1 + ux * r1) * 10) / 10,
    y1: Math.round((y1 + uy * r1) * 10) / 10,
    x2: Math.round((x2 - ux * r2) * 10) / 10,
    y2: Math.round((y2 - uy * r2) * 10) / 10,
  };
}

// Shuffled first, not just mapped in definition order — otherwise which
// role lands where (and so which node ends up "highlighted" as a top
// suggestion later) is fixed every time, and candidates/excluded nodes
// end up clustered rather than mixed in among each other.
const suggestionPeopleBase = seededShuffle(
  [
    { id: "f1", role: "friend" },
    { id: "f2", role: "friend" },
    { id: "f3", role: "friend" },
    { id: "f4", role: "friend" },
    { id: "pending1", role: "pending" },
    { id: "pending2", role: "pending" },
    { id: "blocked1", role: "blocked" },
    { id: "blocked2", role: "blocked" },
    { id: "c1", role: "candidate", mutual: 2, shared: 1 },
    { id: "c2", role: "candidate", mutual: 1, shared: 2 },
    { id: "c3", role: "candidate", mutual: 0, shared: 1 },
    { id: "c4", role: "candidate", mutual: 1, shared: 0 },
    { id: "c5", role: "candidate", mutual: 2, shared: 0 },
    { id: "c6", role: "candidate", mutual: 0, shared: 2 },
  ],
  8072026
).map((p, i) => {
  const score = p.role === "candidate" ? (p.mutual ?? 0) * 3 + (p.shared ?? 0) * 2 : 0;
  // Loose, unevenly-nudged starting ring — just a seed for the relaxation
  // below, not the final layout.
  const angle = (i / 14) * Math.PI * 2 - Math.PI / 2 + (suggRand() - 0.5) * 0.6;
  const radius = 140 + (suggRand() - 0.5) * 70;
  return {
    ...p,
    score,
    x: SUGG_CENTER + radius * Math.cos(angle),
    y: SUGG_CENTER + radius * Math.sin(angle),
  };
});

// Connectivity: each node links to its next neighbor in shuffle order
// (a cycle, so every node has 2 connections minimum) plus a "skip" chord
// from every other node — since the shuffle already scrambled who's
// adjacent, this doesn't trace a clean outline the way connecting
// geometric ring-neighbors did.
const N = suggestionPeopleBase.length;
const suggestionPairs: [number, number][] = [];
for (let i = 0; i < N; i++) {
  suggestionPairs.push([i, (i + 1) % N]);
  if (i % 2 === 0) suggestionPairs.push([i, (i + 5) % N]);
}

const REPEL = 42000;
const REPEL_YOU = 60000;
const SPRING_K = 0.05;
const IDEAL_LEN = 95;
const R_MIN = 65;
const R_MAX = 205;
let suggStep = 1.4;
for (let iter = 0; iter < 260; iter++) {
  const fx = new Array(N).fill(0);
  const fy = new Array(N).fill(0);

  for (let i = 0; i < N; i++) {
    const a = suggestionPeopleBase[i];
    for (let j = i + 1; j < N; j++) {
      const b = suggestionPeopleBase[j];
      const dx = a.x - b.x;
      const dy = a.y - b.y;
      const d = Math.max(Math.hypot(dx, dy), 8);
      const f = REPEL / (d * d);
      fx[i] += (dx / d) * f;
      fy[i] += (dy / d) * f;
      fx[j] -= (dx / d) * f;
      fy[j] -= (dy / d) * f;
    }
    const dcx = a.x - SUGG_CENTER;
    const dcy = a.y - SUGG_CENTER;
    const dc = Math.max(Math.hypot(dcx, dcy), 8);
    const fc = REPEL_YOU / (dc * dc);
    fx[i] += (dcx / dc) * fc;
    fy[i] += (dcy / dc) * fc;
  }

  for (const [i, j] of suggestionPairs) {
    const a = suggestionPeopleBase[i];
    const b = suggestionPeopleBase[j];
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const d = Math.max(Math.hypot(dx, dy), 8);
    const f = SPRING_K * (d - IDEAL_LEN);
    fx[i] += (dx / d) * f;
    fy[i] += (dy / d) * f;
    fx[j] -= (dx / d) * f;
    fy[j] -= (dy / d) * f;
  }

  for (let i = 0; i < N; i++) {
    const a = suggestionPeopleBase[i];
    a.x += fx[i] * suggStep;
    a.y += fy[i] * suggStep;
    const dx = a.x - SUGG_CENTER;
    const dy = a.y - SUGG_CENTER;
    const d = Math.hypot(dx, dy) || 1;
    const clamped = Math.min(Math.max(d, R_MIN), R_MAX);
    a.x = SUGG_CENTER + (dx / d) * clamped;
    a.y = SUGG_CENTER + (dy / d) * clamped;
  }
  suggStep *= 0.99;
}

const suggestionPeople = suggestionPeopleBase.map((p) => ({
  ...p,
  x: Math.round(p.x * 10) / 10,
  y: Math.round(p.y * 10) / 10,
}));

const suggestionCandidatesByScore = suggestionPeople
  .filter((p) => p.role === "candidate")
  .sort((a, b) => b.score - a.score);

const suggestionSignalEdges = suggestionPeople
  .filter((p) => p.role === "candidate" && (p.mutual ?? 0) > 0)
  .map((p) => suggTrim(SUGG_CENTER, SUGG_CENTER, p.x, p.y, SUGG_YOU_R, SUGG_NODE_R));

const suggestionPeerEdges = suggestionPairs.map(([i, j]) =>
  suggTrim(
    suggestionPeople[i].x,
    suggestionPeople[i].y,
    suggestionPeople[j].x,
    suggestionPeople[j].y,
    SUGG_NODE_R,
    SUGG_NODE_R
  )
);

