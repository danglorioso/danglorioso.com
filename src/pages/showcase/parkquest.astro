              <text x="101" y="50">Lassen</text>
              <text x="134" y="140" text-anchor="end">Yosemite</text>
              <text x="174" y="180">Kings Canyon</text>
              <text x="154" y="203" text-anchor="end">Sequoia</text>
              <text x="201" y="213">Death Valley</text>
              <text x="216" y="284">Joshua Tree</text>
              <text x="95" y="297" text-anchor="middle">Channel Islands</text>
              <text x="64" y="192" text-anchor="end">Pinnacles</text>
