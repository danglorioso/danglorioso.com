<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initParkQuestHero() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    const content = document.querySelector(".pq-hero-content");
    if (!content) return;
    const targets = [
      content.querySelector(".pq-app-icon"),
      content.querySelector(".pq-eyebrow"),
      content.querySelector(".pq-title"),
      content.querySelector(".pq-tagline"),
      content.querySelector(".pq-subtext"),
      content.querySelector(".pq-hero-links"),
    ].filter(Boolean);
    if (!targets.length) return;

    gsap.set(content, { opacity: 1 });
    gsap.from(targets, {
      y: 22,
      opacity: 0,
      duration: 0.7,
      ease: "power2.out",
      stagger: 0.1,
      delay: 0.15,
    });
  }

  function initParkQuestScroll() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    const mm = gsap.matchMedia();

    mm.add("(min-width: 900px)", () => {
      const section = document.getElementById("pq-feature-section");
      const screens = gsap.utils.toArray<HTMLElement>(".pq-screen");
      const captions = gsap.utils.toArray<HTMLElement>(".pq-caption");
      if (!section || screens.length < 3 || captions.length < 3) return;

      gsap.set(screens, { autoAlpha: 0 });
      gsap.set(screens[0], { autoAlpha: 1 });
      gsap.set(captions, { opacity: 0.3 });
      gsap.set(captions[0], { opacity: 1 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top+=90",
          end: "+=1600",
          scrub: 0.6,
          pin: ".pq-phone-stage",
          anticipatePin: 1,
        },
      });

      for (let i = 1; i < screens.length; i++) {
        tl.to(screens[i - 1], { autoAlpha: 0, duration: 0.4 }, i)
          .to(screens[i], { autoAlpha: 1, duration: 0.4 }, i)
          .to(captions[i - 1], { opacity: 0.3, duration: 0.4 }, i)
          .to(captions[i], { opacity: 1, duration: 0.4 }, i);
      }

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    });
  }

  function initParkQuest() {
    initParkQuestHero();
    initParkQuestScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initParkQuest);
  } else {
    initParkQuest();
  }
</script>
