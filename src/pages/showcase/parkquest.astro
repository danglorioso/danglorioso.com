    title: "Weighted scoring",
    desc: "The formula weights mutual friends higher, since a real friendship predicts a real-world relationship better than “we both went to Yellowstone” does. It sorts candidates by score and returns the top N.",
    formula: "score = mutual_friends × 3 + shared_parks × 2",
  },
  {
    n: 5,
    title: "Cold-start fallback",
    desc: "When scored candidates don't fill the requested count, which often occurs for brand-new user with no friends or visits yet, the algorithm backfills with the most-active explorers overall—still excluding everyone already seen.",
  },
  {
    n: 6,
    title: "Enrichment",
    desc: "A parallel Promise.all batch-fetches profiles and visit counts for the final candidate set; JS then joins them with Map lookups instead of one giant SQL join. Each query stays simple and indexable this way.",
