---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Activity from "../components/Activity.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Dan Glorioso | CS Student @ Tufts"
  description="Dan Glorioso — CS Student at Tufts, full-stack developer, and passionate technologist."
  homepage={true}
>
  <section id="home">
    <div class="h-full w-full flex flex-col gap-12 md:gap-16">
      <!-- Hero Section -->
      <Hero />

      <!-- GitHub Activity -->
      <Activity />

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-bg-card border border-border-primary text-text-secondary hover:text-text-primary hover:border-accent-primary transition-all duration-200 text-sm font-medium"
        >
          About me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-bg-card border border-border-primary text-text-secondary hover:text-text-primary hover:border-accent-primary transition-all duration-200 text-sm font-medium"
        >
          My projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Contact Form -->
      <div class="flex flex-col gap-6">
        <h2 class="text-3xl font-bold text-text-primary">Get In Touch</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>
